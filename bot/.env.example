# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Mini App joylashgan HTTPS manzil (GitHub Pages, Vercel, Netlify va h.k.)
WEBAPP_URL=https://USERNAME.github.io/bomdodnamozappbot/

# Eslatma vaqtlari (soat, Toshkent vaqti bilan)
MORNING_HOUR=6
EVENING_HOUR=18

# Haftalik reyting xulosasi — yakshanba kuni, soat (Toshkent vaqti)
WEEKLY_HOUR=20

# Reyting API porti. Mini App (webapp/data.js → apiUrl) shu serverga murojaat qiladi.
# Railway/Render kabi hostinglar PORT o'zgaruvchisini o'zi beradi — u bo'lsa shu ishlatiladi.
API_PORT=8080

# Super adminlar — Telegram ID lari, vergul bilan. Faqat shularga ilovadagi
# «Video qo'shish» paneli ko'rinadi. ID ni bilish uchun botga /id yozing.
ADMIN_IDS=123456789

# Ma'lumotlar papkasi (reyting.db, users.json). Railway'da volume ulab, mount yo'lini shu yerga yozing.
# Bo'sh qoldirilsa — bot/ papkasi. Volume'siz Railway har deploy'da bazani o'chiradi!
DATA_DIR=/data

# Haftalik baza zaxirasi — shu kuni 03:00 da birinchi adminga Telegram orqali fayl keladi. Bo'sh — o'chiq.
BACKUP_DAY=mon

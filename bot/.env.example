# ============================================================
#  Railway'da faqat 2 ta o'zgaruvchi kerak: BOT_TOKEN va ADMIN_IDS.
#  Qolganlari o'zi to'g'ri qiymatni topadi — pastda izohlarda yozilgan.
#  Lokal ishlatish uchun bu faylni .env deb nusxalang.
# ============================================================

# ---------- SHART ----------

# @BotFather dan olingan token
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Super adminlar — Telegram ID lari, vergul bilan.
# /stat (statistika), /backup (baza nusxasi) va ilovadagi «Video qo'shish» paneli
# faqat shularga ochiq. ID ni bilish uchun botga /id yozing.
ADMIN_IDS=123456789


# ---------- IXTIYORIY (ko'rsatilmasa o'zi topadi) ----------

# Mini App manzili. Ko'rsatilmasa: https://izzatxd.github.io/BomdodNamoz/
# Boshqa joyga joylasangiz (Vercel, Netlify, o'z domeningiz) shu yerda yozing.
# WEBAPP_URL=https://USERNAME.github.io/BomdodNamoz/

# Ma'lumotlar papkasi (reyting.db, users.json).
# Ko'rsatilmasa: /data mavjud bo'lsa — o'sha (Railway volume), aks holda bot/ papkasi.
# Ya'ni Railway'da Volume ni /data ga ulasangiz, bu o'zgaruvchi kerak emas.
# DATA_DIR=/data

# Reyting API porti. Railway/Render PORT ni o'zi beradi — yozmang.
# API_PORT=8080

# Eslatma vaqtlari (soat, Toshkent vaqti bilan)
# MORNING_HOUR=6
# EVENING_HOUR=18

# Haftalik reyting xulosasi — yakshanba kuni, soat
# WEEKLY_HOUR=20

# Haftalik baza zaxirasi — shu kuni 03:00 da birinchi adminga Telegram orqali fayl keladi.
# Bo'sh qoldirilsa — o'chiq.
# BACKUP_DAY=mon
